{
  "info": {
    "_postman_id": "9fcb5a1b-7d52-4c5c-b47f-7day-todo-api",
    "name": "TodoAPI",
    "description": "Complete collection for the 7-day Spring Boot To-Do App training project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "taskDate",
      "value": "2026-09-25"
    }
  ],
  "item": [
    {
      "name": "1. Create Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn Spring Boot\",\n  \"description\": \"Day 4 practice\",\n  \"taskDate\": \"2026-09-25\",\n  \"taskTime\": \"18:30:00\",\n  \"status\": \"ONGOING\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks"]
        }
      }
    },
    {
      "name": "2. Get All Tasks",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks"]
        }
      }
    },
    {
      "name": "3. Get Task By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "4. Get Tasks By Date",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/tasks/by-date?date={{taskDate}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "by-date"],
          "query": [
            {
              "key": "date",
              "value": "{{taskDate}}"
            }
          ]
        }
      }
    },
    {
      "name": "5. Update Task (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn Spring Boot - Updated\",\n  \"description\": \"Full CRUD practice\",\n  \"taskDate\": \"2026-09-25\",\n  \"taskTime\": \"19:00:00\",\n  \"status\": \"ONGOING\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "6. Update Status (PATCH)",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}/status?status=FINISHED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "{{taskId}}", "status"],
          "query": [
            {
              "key": "status",
              "value": "FINISHED"
            }
          ]
        }
      }
    },
    {
      "name": "7. Delete Task",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "Validation Demo - Empty Title",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"description\": \"Should fail validation\",\n  \"taskDate\": \"2026-09-25\",\n  \"taskTime\": \"18:30:00\",\n  \"status\": \"ONGOING\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks"]
        }
      }
    },
    {
      "name": "Error Demo - Missing Task",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/tasks/9999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "9999"]
        }
      }
    }
  ]
}
